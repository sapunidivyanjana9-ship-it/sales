# Database configuration - committed on purpose so a fresh clone runs
# immediately (`php -S localhost:8000`) with zero setup, matching a stock
# XAMPP/WAMP/MAMP install (root, no password).
#
# If your local MySQL/MariaDB differs (e.g. a plain apt-installed MySQL on
# Ubuntu, which usually has a real root password), just edit the values
# below directly - config/env.php reads this file.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=pearl_land_db
DB_USER=root
DB_PASS=
